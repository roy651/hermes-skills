TELEGRAM_BOT_TOKEN=<from @BotFather>

# Telegram chat IDs — get from @userinfobot
# Comma-separated list of all users allowed to use the bot
ALLOWED_USER_IDS=<id1>,<id2>
# The Hermes agent user's chat ID (used by the HTTP API)
AGENT_USER_ID=<hermes_user_chat_id>

# OpenRouter
LLM_API_KEY=<openrouter key>
LLM_MODEL=anthropic/claude-haiku-4.5

# Optional overrides
# DB_PATH=/custom/path/pa.db
# API_PORT=8766
