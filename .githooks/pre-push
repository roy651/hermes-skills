#!/usr/bin/env bash
# Guardrail — block pushes FROM THE MINI-PC (the Hermes agent's host). Deploys to the mini-PC are
# pull-only; real pushes happen from the dev machine. The agent once autonomously pushed holdings to
# a public repo — this stops it pushing anything at all, unattended. Deliberate override:
#   HERMES_ALLOW_PUSH=1 git push
# Enabled via `git config core.hooksPath .githooks` (set on both clones).
set -euo pipefail
host=$(hostname 2>/dev/null || echo "")
case "$host" in
  *homeabit*|*mini-pc*|*minipc*)
    if [ "${HERMES_ALLOW_PUSH:-}" != "1" ]; then
      echo "✋ pre-push BLOCKED on '$host' — the agent host is pull-only."
      echo "   Push from the dev machine, or for a deliberate push here: HERMES_ALLOW_PUSH=1 git push"
      exit 1
    fi ;;
esac
exit 0
