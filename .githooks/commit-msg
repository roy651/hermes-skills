#!/usr/bin/env bash
# Guardrail — THIS REPO IS PUBLIC. Block commit MESSAGES that leak positions (quantities/prices),
# e.g. "add DD — 20 units @ 134.41". Describe changes generically. Bypass (rarely): --no-verify
set -euo pipefail
msg=$(cat "$1")
if echo "$msg" | grep -qiE '[0-9]+ units|units @|@ [0-9]+\.[0-9]|qty [0-9]|brokerage statement|[0-9]{2,}[[:space:]]*(→|->)[[:space:]]*[0-9]{2,}'; then
  echo "✋ commit-msg BLOCKED — the message looks like it contains position data (qty/price)."
  echo "   This repo is PUBLIC. Describe the change without holdings/amounts. Bypass: --no-verify"
  exit 1
fi
exit 0
