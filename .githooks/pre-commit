#!/usr/bin/env bash
# Guardrail — THIS REPO IS PUBLIC. Block committing portfolio PII (holdings, secnum map, the
# portfolio mapping doc) or holdings-shaped content. Applies to anyone who commits (Hermes agent,
# Claude, human) once `git config core.hooksPath .githooks` is set (see scripts/setup-hooks.sh).
# Genuine emergency bypass: git commit --no-verify
set -euo pipefail

staged=$(git diff --cached --name-only || true)
blocked=""
for f in $staged; do
  case "$f" in
    */holdings.json|*/secnum_map.json|*roy-portfolio-tickers*|*/holdings.*.json|*portfolio_import*.xlsx)
      blocked="$blocked $f" ;;
  esac
done
if [ -n "$blocked" ]; then
  echo "✋ pre-commit BLOCKED — portfolio PII file(s) staged:$blocked"
  echo "   This repo is PUBLIC; holdings/secnum data must stay gitignored (runtime-only)."
  echo "   Real emergency only: git commit --no-verify"
  exit 1
fi

# Content scan: staged ADDED lines that look like holdings DATA — a qty/avg_cost key followed by a
# number (e.g. "qty": 100). Both patterns require the numeric value so code that merely reads the
# fields (holding["avg_cost"]) doesn't trip. Exclude .githooks/ to avoid self-tripping.
if git diff --cached -U0 -- . ':!.githooks/' | grep -E '^\+' | grep -qE '"avg_cost"[[:space:]]*:[[:space:]]*[0-9]|"qty"[[:space:]]*:[[:space:]]*[0-9]'; then
  echo "✋ pre-commit BLOCKED — staged content looks like holdings data (qty/avg_cost)."
  echo "   This repo is PUBLIC; keep holdings runtime-only. Bypass (rarely): git commit --no-verify"
  exit 1
fi
exit 0
